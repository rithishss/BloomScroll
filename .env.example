# ── Supabase (real mode) ────────────────────────────────────────────────
# Project URL and publishable (anon) key: Supabase dashboard → Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Service-role key. Server-only: used by the ingestion pipeline. Never expose.
SUPABASE_SERVICE_ROLE_KEY=

# ── OpenAI-compatible models (real mode) ────────────────────────────────
OPENAI_API_KEY=
# Optional: point at any OpenAI-compatible endpoint.
# OPENAI_BASE_URL=
OPENAI_CHAT_MODEL=gpt-4o-mini
# Embedding model must match the pgvector dimension in the migrations (1536).
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Narration voice for rendered reels (lib/video/tts.ts).
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy

# ── App behaviour ───────────────────────────────────────────────────────
# Demo mode works with zero credentials; the /demo workspace is always available.
NEXT_PUBLIC_DEMO_MODE=true
MAX_PDF_SIZE_MB=20
